# === API Keys ===
OPENAI_API_KEY=your_key_here
GEMINI_API_KEY=your_key_here
FRED_API_KEY=your_key_here
FINNHUB_API_KEY=
FMP_API_KEY=

# === Core Runtime (Cloud-Ready Defaults) ===
CORE_DB_BACKEND=postgres
ANNOTATIONS_READ_SOURCE=poly
CORE_DB_STRICT_POSTGRES=1
CORE_DB_GUARD_ENFORCE=1
POSTGRES_DSN=postgresql://investor:investor_dev@127.0.0.1:5432/investor_os
AI_QUEUE_BACKEND=postgres
AI_QUEUE_STRICT_PROD=1
AI_REDIS_URL=redis://127.0.0.1:6379/0
APP_HOST=0.0.0.0
APP_PORT=8766
ALLOW_LOCAL_ENV_FILE=1

# === SEC EDGAR (required for filing downloads) ===
SEC_USER_AGENT=YourName your@email.com

# === AI Provider Routing ===
# Primary: "openai" (default, cheap cloud) | "anthropic" | "ollama" (free local)
AI_PROVIDER=openai
# Fallback when primary fails:
AI_FALLBACK_PROVIDER=ollama

# === Model Overrides (optional) ===
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_MODEL=gpt-oss:20b
# AI_MAX_TOKENS=3000
# AI_TIMEOUT_SECONDS=90

# === AI Brain Tuning ===
AI_QA_VERIFIER_TEMPERATURE=0.2
AI_FACTCHECK_MAX_FLAGS=5
AI_FINANCIAL_CTX_MAX_CHARS=5000
AI_REFLEXION_DECAY_HALF_LIFE_DAYS=60
AI_REFLEXION_MIN_SCORE=0.3
AI_REFLEXION_MIN_CONFIDENCE=0.6
AI_CALL_LOG_ENABLED=1
AI_CASCADE_RECURSIVE_MAX_DEPTH=3
AUTONOMIC_INTERVAL_SEC=28800

# === Debate Service ===
DEBATE_SIGNAL_CHARS=1200
DEBATE_REASONING_CHARS=1000
DEBATE_ADVOCATE_CHARS=1500
DEBATE_JUDGE_SIGNAL_CHARS=800
DEBATE_ADVOCATE_WORDS=250-350

# === Earnings Analysis ===
EARNINGS_ANALYSIS_MAX_CHARS=12000
EARNINGS_OPENING_RATIO=0.4

# === Ontology Core Knobs (safe defaults) ===
ONTOLOGY_TEMPORAL_ENABLED=0
ONTOLOGY_DECAY_ENABLED=0
ONTOLOGY_DECAY_HALF_LIFE_DAYS=365
ONTOLOGY_CANONICAL_LLM_ENABLED=0
ONTOLOGY_CANONICAL_DETERMINISTIC_THRESHOLD=0.97
ONTOLOGY_CANONICAL_LLM_MIN_CONFIDENCE=0.86
ONTOLOGY_SIGNED_PROPAGATION_ENABLED=1
ONTOLOGY_RISK_THEME_HOP_FACTOR=0.15
ONTOLOGY_CRITICALITY_REVIEW_ENABLED=1
ONTOLOGY_CRITICALITY_LLM_ENABLED=1
ONTOLOGY_CRITICALITY_LOW_CONF_MAX=0.72
ONTOLOGY_CRITICALITY_MIN_IMPACT_SCORE=0.35
ONTOLOGY_CRITICALITY_LLM_MIN_CONFIDENCE=0.65

# === Email Notifications ===
# Set NOTIFY_EMAIL_ENABLED=1 to send alerts (proposals, debate results, etc.)
NOTIFY_EMAIL_ENABLED=0
NOTIFY_EMAIL_TO=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail: use an App Password (Google Account → Security → App Passwords)
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
# Optional: override From address (defaults to SMTP_USER)
# SMTP_FROM=

# === Organizer Google Calendar (optional, secure OAuth PKCE) ===
# Create an OAuth client in Google Cloud Console and paste the Client ID.
# Redirect URI should match your local app callback URL.
# GOOGLE_OAUTH_CLIENT_ID=your_google_client_id_here
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8766/organizer/google/callback
