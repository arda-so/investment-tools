# Core runtime
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8080

# Strict Postgres-only core
CORE_DB_BACKEND=postgres
CORE_DB_GUARD_ENFORCE=1
CORE_DB_STRICT_POSTGRES=1
PHASE2_POSTGRES_ENABLED=1

# Queue backend
AI_QUEUE_BACKEND=postgres
AI_QUEUE_STRICT_PROD=1

# Database + cache endpoints
POSTGRES_DSN=postgresql://<user>:<password>@<host>:5432/<db>
AI_REDIS_URL=redis://<redis-host>:6379/0

# Optional Postgres pool tuning
POSTGRES_POOL_SIZE=8
POSTGRES_MAX_OVERFLOW=16
POSTGRES_POOL_RECYCLE_SEC=1800

# Admin API protection
AI_ADMIN_API_ENABLED=0
AI_ADMIN_API_KEY=<set_a_long_random_key_if_enabled>

# LLM provider keys (set as secret env vars in cloud)
GEMINI_API_KEY=<required_if_using_gemini>
OPENAI_API_KEY=<optional>

# Cloud file store (GCS) for reports/filings/data parity
CLOUD_FILES_BUCKET=<your_gcs_bucket>
CLOUD_FILES_PREFIX=

# Optional behavior tuning
AI_PROMPT_CACHE_TTL_SEC=75
AI_WORKER_JOB_TIMEOUT_SEC=90
AI_SSE_PARTIAL_AFTER_SEC=2
