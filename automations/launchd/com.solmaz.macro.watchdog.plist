<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.solmaz.macro.watchdog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/solmaz/Investment_Tools/automations/macro_watchdog.sh</string>
  </array>

  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>31</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>8</integer>
      <key>Minute</key><integer>40</integer>
    </dict>
    <dict>
      <key>Hour</key><integer>12</integer>
      <key>Minute</key><integer>5</integer>
    </dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/solmaz/Investment_Tools/logs/launchd_macro_watchdog.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/solmaz/Investment_Tools/logs/launchd_macro_watchdog_err.log</string>
</dict>
</plist>

