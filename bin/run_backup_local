#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/solmaz/Investment_Tools"
BACKUP_DIR="${ROOT}/backups"
DRY_RUN=0
RETENTION_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --retention-only) RETENTION_ONLY=1 ;;
    *)
      echo "Unknown option: $arg"
      echo "Usage: $0 [--dry-run] [--retention-only]"
      exit 2
      ;;
  esac
done

mkdir -p "$BACKUP_DIR"

create_backup() {
  local ts out
  ts="$(date +%Y%m%d_%H%M%S)"
  out="${BACKUP_DIR}/investment_tools_backup_${ts}.tar.gz"
  echo "Creating backup: ${out}"
  tar -czf "$out" \
    --exclude='./backups/*' \
    --exclude='./.git/*' \
    --exclude='./.venv-memory/*' \
    --exclude='./.venv/*' \
    --exclude='./node_modules/*' \
    -C "$ROOT" .
  echo "Backup created: ${out}"
}

prune_old_backups() {
  echo "Pruning backups older than 7 days"
  if [ "$DRY_RUN" -eq 1 ]; then
    find "$BACKUP_DIR" -mindepth 1 -mtime +7 -print
  else
    # Exact 7-day FIFO retention command requested.
    find "$BACKUP_DIR" -mindepth 1 -mtime +7 -delete
  fi
}

if [ "$RETENTION_ONLY" -eq 0 ]; then
  create_backup
fi
prune_old_backups

if [ "$DRY_RUN" -eq 1 ]; then
  echo "Dry run complete."
else
  echo "Backup + retention complete."
fi
