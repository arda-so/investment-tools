#!/usr/bin/env bash
set -euo pipefail

ROOT="/Users/solmaz/Investment_Tools"
BACKUP_DIR="${ROOT}/backups"
DRY_RUN=0
RETENTION_ONLY=0

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=1 ;;
    --retention-only) RETENTION_ONLY=1 ;;
    *)
      echo "Unknown option: $arg"
      echo "Usage: $0 [--dry-run] [--retention-only]"
      exit 2
      ;;
  esac
done

mkdir -p "$BACKUP_DIR"

create_backup() {
  local ts out out_tmp list_file
  ts="$(date +%Y%m%d_%H%M%S)"
  out="${BACKUP_DIR}/investment_tools_backup_${ts}.tar.gz"
  out_tmp="${out}.tmp"
  list_file="$(mktemp)"
  echo "Creating DB-only backup: ${out}"
  (
    cd "$ROOT"
    # Lean whitelist: core runtime databases only.
    for p in \
      "./data/core.db" \
      "./data/core.db-wal" \
      "./data/core.db-shm" \
      "./data/ai_queue.db" \
      "./data/cache.db" \
      "./onyx_brain.db" \
      "./onyx_data/memory_db/chroma.sqlite3"
    do
      [ -f "$p" ] && printf '%s\n' "${p#./}" >> "$list_file"
    done
  )
  if [ ! -s "$list_file" ]; then
    rm -f "$list_file"
    echo "No database files found to back up."
    return 1
  fi
  tar -czf "$out_tmp" -C "$ROOT" -T "$list_file"
  mv -f "$out_tmp" "$out"
  rm -f "$list_file"
  echo "Backup created (DB-only): ${out}"
}

prune_old_backups() {
  echo "Pruning backups older than 7 days"
  if [ "$DRY_RUN" -eq 1 ]; then
    find "$BACKUP_DIR" -mindepth 1 -mtime +7 -print
  else
    # Exact 7-day FIFO retention command requested.
    find "$BACKUP_DIR" -mindepth 1 -mtime +7 -delete
  fi
}

if [ "$RETENTION_ONLY" -eq 0 ]; then
  create_backup
fi
prune_old_backups

if [ "$DRY_RUN" -eq 1 ]; then
  echo "Dry run complete."
else
  echo "Backup + retention complete."
fi
