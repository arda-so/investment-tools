#!/usr/bin/env bash
# Cloud Run job: signals refresh (weekdays noon UTC)
set -euo pipefail
ROOT="${INVESTOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"
export CORE_DB_BACKEND="postgres"
export CORE_DB_GUARD_ENFORCE="1"
export CORE_DB_STRICT_POSTGRES="1"
export PHASE2_POSTGRES_ENABLED="${PHASE2_POSTGRES_ENABLED:-1}"
export AI_QUEUE_BACKEND="${AI_QUEUE_BACKEND:-postgres}"

if [ -x "$ROOT/.venv-memory/bin/python" ]; then
  PY="$ROOT/.venv-memory/bin/python"
else
  PY="python3"
fi

echo "[signals_job] Starting $(date -u)"
"$PY" "$ROOT/market_scanner.py" --signals --data
echo "[signals_job] Done $(date -u)"
