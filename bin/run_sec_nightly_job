#!/usr/bin/env bash
# Cloud Run job: nightly SEC sync + proactive monitor (2 AM UTC, before agent worker at 2:30)
# agent_worker --watch-all runs separately via investor-agent-worker-cron at 2:30 AM UTC
set -euo pipefail
ROOT="${INVESTOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"
export CORE_DB_BACKEND="postgres"
export CORE_DB_GUARD_ENFORCE="1"
export CORE_DB_STRICT_POSTGRES="1"
export PHASE2_POSTGRES_ENABLED="${PHASE2_POSTGRES_ENABLED:-1}"
export AI_QUEUE_BACKEND="${AI_QUEUE_BACKEND:-postgres}"
export PYTHONPATH="${ROOT}:${PYTHONPATH:-}"

if [ -x "$ROOT/.venv-memory/bin/python" ]; then
  PY="$ROOT/.venv-memory/bin/python"
else
  PY="python3"
fi

echo "[sec_nightly_job] Starting $(date -u)"
"$PY" "$ROOT/tools/sec_sync_my_companies.py" --days 7 --full-empty-limit 6
"$PY" "$ROOT/tools/run_proactive_monitor.py" --force
"$PY" "$ROOT/tools/run_outcome_measurement.py"
echo "[sec_nightly_job] Done $(date -u)"
