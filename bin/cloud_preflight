#!/usr/bin/env bash
set -euo pipefail

ROOT="${INVESTOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

fail() { echo "FAIL: $1"; exit 1; }
pass() { echo "PASS: $1"; }
warn() { echo "WARN: $1"; }

need_cmd() {
  command -v "$1" >/dev/null 2>&1 || fail "missing command: $1"
}

echo "== Cloud Preflight =="

need_cmd curl
need_cmd python3

MODE="${1:-local}"
if [ "$MODE" != "local" ] && [ "$MODE" != "--gcp" ]; then
  fail "usage: ./bin/cloud_preflight [local|--gcp]"
fi

if [ "$MODE" = "--gcp" ]; then
  need_cmd gcloud
  PROJECT_ID="${PROJECT_ID:-$(gcloud config get-value project 2>/dev/null || true)}"
  REGION="${REGION:-europe-west1}"
  REPO="${REPO:-investor-tools}"
  DB_INSTANCE="${DB_INSTANCE:-investor-os-pg}"

  [ -n "${PROJECT_ID:-}" ] && [ "$PROJECT_ID" != "(unset)" ] || fail "PROJECT_ID is empty (set PROJECT_ID or gcloud config set project)"
  gcloud artifacts repositories describe "$REPO" --location="$REGION" --project="$PROJECT_ID" >/dev/null || fail "artifact repo missing: $REPO in $REGION"
  gcloud sql instances describe "$DB_INSTANCE" --project="$PROJECT_ID" >/dev/null || fail "cloud sql instance missing: $DB_INSTANCE"
  gcloud secrets describe POSTGRES_DSN --project="$PROJECT_ID" >/dev/null || fail "secret missing: POSTGRES_DSN"
  if gcloud secrets describe GEMINI_API_KEY --project="$PROJECT_ID" >/dev/null 2>&1; then
    pass "secret present: GEMINI_API_KEY"
  else
    warn "secret missing: GEMINI_API_KEY (AI features will be disabled)"
  fi
  pass "gcp resource checks passed"
  echo "Cloud preflight completed."
  exit 0
fi

if [ ! -f ".env" ]; then
  fail ".env not found. copy .env.cloud.example -> .env and set real values"
fi

set -a
source ./.env
set +a

[ -n "${POSTGRES_DSN:-}" ] || fail "POSTGRES_DSN is empty"
[ -n "${AI_REDIS_URL:-}" ] || fail "AI_REDIS_URL is empty"
[ "${CORE_DB_BACKEND:-}" = "postgres" ] || fail "CORE_DB_BACKEND must be postgres"
[ "${CORE_DB_STRICT_POSTGRES:-1}" = "1" ] || fail "CORE_DB_STRICT_POSTGRES must be 1"
[ "${CORE_DB_GUARD_ENFORCE:-1}" = "1" ] || fail "CORE_DB_GUARD_ENFORCE must be 1"

pass "env variables present"

PYBIN="python3"
if [ -x "./.venv-memory/bin/python" ]; then
  PYBIN="./.venv-memory/bin/python"
fi

"$PYBIN" - <<'PY' || fail "python import preflight failed"
import importlib
mods = ["fastapi", "uvicorn", "jinja2", "psycopg2"]
for m in mods:
    importlib.import_module(m)
print("imports_ok")
PY
pass "python dependencies look good"

if curl -fsS --max-time 6 "http://127.0.0.1:${APP_PORT:-8766}/health/live" >/dev/null 2>&1; then
  pass "app live endpoint reachable"
  curl -fsS --max-time 8 "http://127.0.0.1:${APP_PORT:-8766}/health/ready" >/dev/null && pass "app ready endpoint reachable" || warn "ready endpoint failed"
  curl -fsS --max-time 8 "http://127.0.0.1:${APP_PORT:-8766}/ai/worker/health" >/dev/null && pass "worker health endpoint reachable" || warn "worker health endpoint failed"
else
  warn "app not running on localhost:${APP_PORT:-8766} (skip live endpoint checks)"
fi

echo "Cloud preflight completed."
