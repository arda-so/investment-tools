#!/usr/bin/env bash
set -euo pipefail

ROOT="${INVESTOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  cat <<'EOF'
Usage: bin/run_test_app

Starts Investor OS in isolated LOCAL TEST mode.

Environment:
  TEST_ENV_FILE   Path to env file (default: .env.test)
  APP_HOST        Default 127.0.0.1
  APP_PORT        Default 8877
EOF
  exit 0
fi

ENV_FILE="${TEST_ENV_FILE:-$ROOT/.env.test}"
if [ -f "$ENV_FILE" ]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

export APP_ENV="${APP_ENV:-test}"
export ENVIRONMENT="${ENVIRONMENT:-test}"
export ALLOW_LOCAL_ENV_FILE="${ALLOW_LOCAL_ENV_FILE:-0}"
export APP_HOST="${APP_HOST:-127.0.0.1}"
export APP_PORT="${APP_PORT:-8877}"

# Keep test fully isolated from dev/prod defaults.
export CORE_DB_BACKEND="${CORE_DB_BACKEND:-postgres}"
export CORE_DB_GUARD_ENFORCE="${CORE_DB_GUARD_ENFORCE:-1}"
export CORE_DB_STRICT_POSTGRES="${CORE_DB_STRICT_POSTGRES:-1}"
export AI_QUEUE_BACKEND="${AI_QUEUE_BACKEND:-postgres}"
export AI_QUEUE_STRICT_PROD="${AI_QUEUE_STRICT_PROD:-0}"

if [ -z "${POSTGRES_DSN:-}" ]; then
  echo "ERROR: POSTGRES_DSN is not set. Create .env.test from .env.test.example."
  exit 2
fi

if [[ "${POSTGRES_DSN}" != *"test"* ]]; then
  echo "WARNING: POSTGRES_DSN does not look like a test database DSN."
  echo "Current DSN: ${POSTGRES_DSN}"
  echo "Set a dedicated test DB in .env.test (example: investor_os_test)."
fi

if [ "${RUN_TEST_KILL_PORT:-1}" = "1" ]; then
  PIDS="$(lsof -ti tcp:"${APP_PORT}" 2>/dev/null || true)"
  if [ -n "$PIDS" ]; then
    echo "$PIDS" | xargs kill -9 2>/dev/null || true
  fi
fi

echo "Starting LOCAL TEST app"
echo "URL: http://${APP_HOST}:${APP_PORT}/dashboard"
echo "DB backend: ${CORE_DB_BACKEND} (strict=${CORE_DB_STRICT_POSTGRES})"

if [ -x "$ROOT/.venv-memory/bin/uvicorn" ]; then
  exec "$ROOT/.venv-memory/bin/uvicorn" app.main:app --host "$APP_HOST" --port "$APP_PORT"
elif command -v uvicorn >/dev/null 2>&1; then
  exec uvicorn app.main:app --host "$APP_HOST" --port "$APP_PORT"
else
  echo "ERROR: uvicorn not found. Install dependencies or use .venv-memory."
  exit 3
fi
