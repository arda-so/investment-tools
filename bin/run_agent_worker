#!/usr/bin/env bash
# bin/run_agent_worker — Shell entrypoint for the headless agent worker.
# Sets Postgres env vars and delegates to tools/agent_worker.py.
#
# Usage:
#   bin/run_agent_worker --watch [--days 1]
#   bin/run_agent_worker --ticker AAPL --form 10-Q
#   bin/run_agent_worker --ticker AAPL --form 10-Q --accession 0001193125-26-012345
set -euo pipefail

ROOT="${INVESTOR_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
cd "$ROOT"

# Guard: POSTGRES_DSN must be set before any Python code runs.
if [ -z "${POSTGRES_DSN:-}" ]; then
  echo "[run_agent_worker] ERROR: POSTGRES_DSN is not set." >&2
  echo "  Set it in your environment or .env file before running this script." >&2
  exit 1
fi

export CORE_DB_BACKEND="${CORE_DB_BACKEND:-postgres}"
export CORE_DB_GUARD_ENFORCE="${CORE_DB_GUARD_ENFORCE:-1}"
export CORE_DB_STRICT_POSTGRES="${CORE_DB_STRICT_POSTGRES:-1}"
export PHASE2_POSTGRES_ENABLED="${PHASE2_POSTGRES_ENABLED:-1}"
export AI_QUEUE_BACKEND="${AI_QUEUE_BACKEND:-postgres}"

# Use the project virtualenv if present, otherwise fall back to system python3.
if [ -x "$ROOT/.venv-memory/bin/python" ]; then
  exec "$ROOT/.venv-memory/bin/python" "$ROOT/tools/agent_worker.py" "$@"
fi
exec python3 "$ROOT/tools/agent_worker.py" "$@"
